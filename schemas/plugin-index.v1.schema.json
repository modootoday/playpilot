{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/modootoday/playpilot/blob/main/schemas/plugin-index.v1.schema.json",
  "title": "playpilot plugin index v1",
  "description": "index.json, generated by `playpilot render plugins` from the fleet's Plugin resources and served by the plugins host. Entries are sorted by id; grants list network hosts and secret names, never secret values.",
  "type": "object",
  "required": ["version", "plugins"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "required": ["id", "kind", "interface", "wit", "source", "grants"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "metadata.name of the Plugin resource.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": ["wasm-component", "process"]
        },
        "interface": {
          "description": "The WIT interface the plugin exports (schemas/playpilot-plugin.wit).",
          "enum": ["policy-check", "event-sink", "lane-source", "runtime"]
        },
        "wit": {
          "description": "The full WIT reference from the Plugin resource.",
          "type": "string",
          "pattern": "^playpilot:fleet/[a-z0-9]+(-[a-z0-9]+)*@1\\.[0-9]+\\.[0-9]+$"
        },
        "source": {
          "type": "object",
          "required": ["url", "sha256"],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "grants": {
          "type": "object",
          "required": ["network", "secrets"],
          "additionalProperties": false,
          "properties": {
            "network": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "hostname"
              },
              "uniqueItems": true
            },
            "secrets": {
              "description": "Secret names only.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
