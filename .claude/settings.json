{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b claude/*)",
      "Bash(git checkout -B claude/*)",
      "Bash(git rebase origin/main)",
      "Bash(git commit *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push --force-with-lease=claude/*)",
      "Bash(git worktree *)",
      "Bash(cargo fmt *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo run *)",
      "Bash(rustup target add *)",
      "Bash(worker-build *)",
      "Bash(playpilot validate *)",
      "Bash(playpilot plan *)",
      "Bash(playpilot whoami *)",
      "Bash(playpilot render *)",
      "Bash(playpilot sync *)",
      "Bash(playpilot history-check *)",
      "Bash(playpilot surface-check *)",
      "Bash(playpilot mail *)",
      "Bash(playpilot claim *)",
      "Bash(playpilot release *)",
      "Bash(./target/release/playpilot *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge --auto *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "ask": [
      "Bash(wrangler deploy *)",
      "Bash(npx wrangler@4 deploy *)",
      "Bash(wrangler secret *)",
      "Bash(npx wrangler@4 secret *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.dev.vars)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/fleet/mailbox.env)",
      "Read(~/.ssh/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push origin --tags*)",
      "Bash(git add .)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge --admin *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh ruleset *)",
      "Bash(cargo publish *)",
      "Bash(wrangler deploy --env production*)",
      "Bash(npx wrangler@4 deploy --env production*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/plugin/scripts/guard.sh\"",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'R=e80e7a2c605849b2d3fa2aa126aa1004719dc40a; B=\"$(command -v playpilot || echo \"$HOME/.cargo/bin/playpilot\")\"; D=\"$(dirname \"$(dirname \"$B\")\")\"; if [ \"$(cat \"$D/share/playpilot.rev\" 2>/dev/null)\" != \"$R\" ]; then for c in cargo /root/.cargo/bin/cargo \"$HOME/.cargo/bin/cargo\"; do command -v \"$c\" >/dev/null 2>&1 && \"$c\" install --force --locked --quiet --git https://github.com/modootoday/playpilot --rev \"$R\" --root \"$D\" playpilot >&2 && mkdir -p \"$D/share\" && echo \"$R\" > \"$D/share/playpilot.rev\" && break; done; fi; [ -x \"$B\" ] || { echo \"playpilot CLI is missing and could not be installed\" >&2; exit 2; }; PLAYPILOT_PROTECTED_BRANCHES=main exec \"$B\" guard'",
            "timeout": 240
          }
        ]
      }
    ]
  },
  "env": {
    "CARGO_TERM_COLOR": "never"
  }
}
