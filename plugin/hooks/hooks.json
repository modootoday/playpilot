{
  "description": "Refuse git and release actions outside the fleet's pull request flow.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.sh\"", "timeout": 180 }
        ]
      }
    ]
  }
}
